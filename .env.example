# PayPal sandbox REST app (Developer Dashboard > Apps & Credentials > Sandbox).
# Must belong to the sandbox BUSINESS account that receives the test payments.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: a dispute ID for `npm run probe inspect`
PAYPAL_DISPUTE_ID=

# Astropods AI Gateway (OpenAI-compatible). For local development run
# `npm run gateway-key`, which fills these with a 24-hour development key.
ASTRO_GATEWAY_URL=
ASTRO_GATEWAY_API_KEY=
# Model served through the gateway
ASSESS_MODEL=claude-opus-5-5

# Optional AG Studio licence key; without it Studio runs locally with a watermark
VITE_AG_STUDIO_LICENSE_KEY=

# Link scenario cases to real sandbox disputes for live submission, e.g. SCN-1002:PP-R-KUK-10194971
# Unlinked cases use clearly labelled simulated submission.
SANDBOX_LINKS=

# Models AG Studio's AI assistant may use through the gateway (comma-separated, first is default)
STUDIO_AI_MODELS=claude-opus-5-5

# Real PayPal sandbox submissions only happen when this is true. Leave it unset on a public deployment.
ALLOW_SANDBOX_WRITES=
# "live" uses the AI Gateway; "saved" serves fixtures/saved-assessments.json only (no key needed).
# Defaults to live when a gateway key is set, otherwise saved.
AI_MODE=
